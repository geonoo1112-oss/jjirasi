# ─── DART 전자공시 API ───────────────────────────────────
# dart.fss.or.kr → 로그인 → 마이페이지 → Open API 이용 신청
DART_API_KEY=your_dart_api_key_here

# ─── OpenAI API ──────────────────────────────────────────
# platform.openai.com → API Keys → Create new secret key
OPENAI_API_KEY=your_openai_api_key_here

# ─── 카카오 로그인 + 알림 ────────────────────────────────
# developers.kakao.com → 내 애플리케이션 → 앱 만들기
# → 앱 키 → REST API 키 복사
KAKAO_CLIENT_ID=your_kakao_rest_api_key

# 카카오 보안 (선택사항, 있으면 더 안전)
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# 카카오 리다이렉트 URI (카카오 개발자 콘솔에도 동일하게 등록!)
# 개발: http://localhost:3000/api/auth/kakao/callback
# 배포 후: https://yourdomain.com/api/auth/kakao/callback
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# ─── 서버 설정 ───────────────────────────────────────────
# 공시 체크 주기 (분, 기본 2분)
POLL_INTERVAL_MINUTES=2

# 서버 포트
PORT=3000
